# Supabase project URL (Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — server only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Redis — required for API rate limits (all environments)
# Local: docker compose -f docker-compose.redis.yml up -d
REDIS_URL=redis://localhost:6379

# Optional: defaults to 3001
PORT=3001

# Optional: comma-separated origins for CORS (merged with widget dev ports 5174–5180)
CORS_ORIGIN=http://localhost:5173,http://localhost:5175,http://localhost:5180

# Inbox collision warning: another agent reply within N seconds triggers stale_thread (default 30)
# STALE_THREAD_WINDOW_SEC=30

# Optional: browser URL for invite links in logs / email mocks (defaults to first CORS origin)
# PUBLIC_APP_URL=http://localhost:5173

# Email outbound — resend HTTP (default). Set EMAIL_PROVIDER_MOCK=true to simulate sends without hitting Resend.
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER_MOCK=true
# Platform Resend API key (org email domain onboarding + inbound body fetch fallback)
# RESEND_API_KEY=re_xxxx
# Inbound receiving (Resend → Receiving). Use ONE of:
# Fixed address (all workspaces forward here — good for single-tenant / dev):
# RESEND_INBOUND_ADDRESS=support@wemelovora.resend.app
# Or domain only (unique org.*@domain per workspace):
# RESEND_INBOUND_DOMAIN=wemelovora.resend.app
# Webhook signing secret from Resend dashboard (whsec_…) for POST /api/webhooks/resend
# RESEND_WEBHOOK_SECRET=whsec_xxxx
# Optional: encrypt per-org Resend API keys stored in channel_integrations (32+ chars recommended)
# SECRETS_ENCRYPTION_KEY=

# Optional: Resend for internal notifications (assignments, new customer messages, etc.). Falls back to console log if unset.
# NOTIFICATION_RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM=onboarding@resend.dev
# (NOTIFICATION_RESEND_API_KEY defaults to RESEND_API_KEY if set.)

# Intelligent assignment (Sprint 5+): enable per team inbox via inboxes.settings.assignmentMethod (round_robin | balanced); requires org AI on
# (default false; see shared/src/assignmentSettings.js). Distinct from settings.ai.auto_route_to_ai.
# Assignment preview rate limit (Sprint 8+; per org, Redis-backed)
# RATE_LIMIT_ASSIGNMENT_PREVIEW_ORG_WINDOW_MS=60000
# RATE_LIMIT_ASSIGNMENT_PREVIEW_ORG_MAX=60

# Sprint 2 presence/workload Redis keys (prefix asmt: by default):
# ASSIGNMENT_REDIS_KEY_PREFIX=asmt:
# ASSIGNMENT_PRESENCE_TTL_SEC=90
# ASSIGNMENT_ACTIVE_CHATS_TTL_SEC=86400
# ASSIGNMENT_CONVERSATION_LOCK_TTL_SEC=15

# Automation worker (run: npm run worker:automation --workspace server)
# AUTOMATION_POLL_MS=2000
# AUTOMATION_BATCH_SIZE=10
# Process jobs in the API process immediately after enqueue. Use false when running
# `npm run dev` (starts the automation worker) to avoid duplicate notification emails.
# AUTOMATION_PROCESS_INLINE=false
# Secret for POST /api/internal/cron/sla-scan, /lifecycle-scan (every 15 min),
# /unassigned-auto-route-scan (daily), /workflow-schedule-scan
# (header: x-automation-cron-secret)
# AUTOMATION_CRON_SECRET=

# ---------------------------------------------------------------------------
# LLM provider (Phase 3+ copilot)
# Set LLM_PROVIDER to a preset, then the matching API key.
# All presets use an OpenAI-compatible chat API (same openai npm SDK).
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=60000
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_MAX_PROMPT_CHARS=32000
# LLM_RATE_LIMIT_RETRIES=1

# Streaming suggest-reply (not implemented — reserved)
# AI_STREAMING_ENABLED=false

# --- OpenAI (default preset) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Google Gemini (OpenAI-compatible endpoint) ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=...   # or GEMINI_API_KEY / GOOGLE_API_KEY
# LLM_MODEL=gemini-2.0-flash

# --- Groq ---
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...   # or GROQ_API_KEY
# LLM_MODEL=llama-3.3-70b-versatile

# --- Together AI ---
# LLM_PROVIDER=together
# LLM_API_KEY=...   # or TOGETHER_API_KEY

# --- OpenRouter (multi-model gateway) ---
# LLM_PROVIDER=openrouter
# LLM_API_KEY=...   # or OPENROUTER_API_KEY
# LLM_MODEL=openai/gpt-4o-mini

# --- Custom OpenAI-compatible host (Ollama, Azure OpenAI, local proxy, etc.) ---
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
# LLM_API_KEY=optional-for-local

# Rate limits (Redis keys prefixed with rl: by default)
# RATE_LIMIT_REDIS_KEY_PREFIX=rl:
# RATE_LIMIT_REDIS_FAIL_CLOSED=true
# RATE_LIMIT_INCOMING_ORG_MAX=120
# RATE_LIMIT_INCOMING_EMAIL_MAX=20
# RATE_LIMIT_WEBHOOK_EMAIL_MAX=60
# RATE_LIMIT_AI_ORG_MAX=60
# RATE_LIMIT_AI_ORG_USER_MAX=20
# RATE_LIMIT_AI_USER_MAX=30
# RATE_LIMIT_AI_HEAVY_USER_MAX=12
# RATE_LIMIT_AI_COMPOSER_USER_MAX=40
# RATE_LIMIT_AGENT_SEND_MAX=90
# OUTBOUND_FAILURE_LOG_DEDUPE_MS=60000
# RATE_LIMIT_KNOWLEDGE_SEARCH_ORG_MAX=120
# RATE_LIMIT_KNOWLEDGE_SEARCH_USER_MAX=40
# RATE_LIMIT_KNOWLEDGE_UPLOAD_ORG_MAX=30
# RATE_LIMIT_KNOWLEDGE_UPLOAD_USER_MAX=10
# Ops: GET /api/internal/ops/rate-limits (header x-automation-cron-secret)

# Embeddable web messenger widget
# WIDGET_SESSION_JWT_SECRET=change-me-in-production
# WIDGET_API_PUBLIC_URL=http://localhost:3001
# WIDGET_CDN_ORIGIN=http://localhost:3001
# WIDGET_IFRAME_ORIGIN=http://localhost:5175
# WIDGET_DEV_SKIP_DOMAIN_CHECK=true
# WIDGET_DEV_ALLOW_INSECURE_IDENTIFY=true
# SECRETS_ENCRYPTION_KEY=  # required for identify HMAC verify in production
# RATE_LIMIT_WIDGET_BOOTSTRAP_MAX=30
# RATE_LIMIT_WIDGET_MSG_VISITOR_MAX=20
