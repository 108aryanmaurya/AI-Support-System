# Supabase project URL (Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Service role key — server only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Redis — required for API rate limits (all environments)
# Local: docker compose -f docker-compose.redis.yml up -d
REDIS_URL=redis://localhost:6379

# Optional: defaults to 3001
PORT=3001

# Optional: comma-separated origins for CORS (defaults include Vite dev URL)
CORS_ORIGIN=http://localhost:5173

# Optional: browser URL for invite links in logs / email mocks (defaults to first CORS origin)
# PUBLIC_APP_URL=http://localhost:5173

# Email outbound — resend HTTP (default). Set EMAIL_PROVIDER_MOCK=true to simulate sends without hitting Resend.
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER_MOCK=true

# Optional: Resend for internal notifications (assignments, new customer messages, etc.). Falls back to console log if unset.
# NOTIFICATION_RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM=onboarding@resend.dev
# (NOTIFICATION_RESEND_API_KEY defaults to RESEND_API_KEY if set.)

# Automation worker (run: npm run worker:automation --workspace server)
# AUTOMATION_POLL_MS=2000
# AUTOMATION_BATCH_SIZE=10
# AUTOMATION_PROCESS_INLINE=true
# Secret for POST /api/internal/cron/sla-scan (header: x-automation-cron-secret)
# AUTOMATION_CRON_SECRET=

# Rate limits (Redis keys prefixed with rl: by default)
# RATE_LIMIT_REDIS_KEY_PREFIX=rl:
# RATE_LIMIT_REDIS_FAIL_CLOSED=true
# RATE_LIMIT_INCOMING_ORG_MAX=120
# RATE_LIMIT_INCOMING_EMAIL_MAX=20
# RATE_LIMIT_WEBHOOK_EMAIL_MAX=60
# RATE_LIMIT_AI_ORG_MAX=60
# RATE_LIMIT_AI_ORG_USER_MAX=20
# RATE_LIMIT_AI_USER_MAX=30
# RATE_LIMIT_AGENT_SEND_MAX=90
# OUTBOUND_FAILURE_LOG_DEDUPE_MS=60000
# RATE_LIMIT_KNOWLEDGE_SEARCH_ORG_MAX=120
# RATE_LIMIT_KNOWLEDGE_SEARCH_USER_MAX=40
# RATE_LIMIT_KNOWLEDGE_UPLOAD_ORG_MAX=30
# RATE_LIMIT_KNOWLEDGE_UPLOAD_USER_MAX=10
# Ops: GET /api/internal/ops/rate-limits (header x-automation-cron-secret)
